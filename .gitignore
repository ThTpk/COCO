# --- สภาพแวดล้อม Python -----------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- ผลลัพธ์ที่ pipeline สร้างเอง -------------------------------------------
# ไม่เก็บของที่รันใหม่ได้ ยกเว้นไฟล์เดียวที่หน้าเว็บต้องใช้ (ดูข้อยกเว้นข้างล่าง)
output/*
# เจ็ดโมเดลที่หน้าเว็บสลับดูได้ ต้องอยู่ใน repo ไม่งั้นหน้าเว็บพัง
!output/character_rigged.glb
!output/character2_rigged.glb
!output/character3_rigged.glb
!output/character4_rigged.glb
!output/croc_hunyuan_v4_rigged.glb
!output/croc_photo_rigged.glb
!output/croc_photo_unirig_rigged.glb

# ภาพตรวจงานระหว่างทาง สร้างใหม่ได้ทุกเมื่อด้วย --debug
output/debug/

# ไฟล์รูปทรงระหว่างทางที่หลุดมาอยู่นอก output/ ปั้นใหม่ได้จาก pipeline เดิม
photo_shape.glb

# --- ไฟล์อ้างอิงขนาดใหญ่ -----------------------------------------------------
# โมเดลกายวิภาค 31 MB ที่ไม่ได้ใช้ในโค้ดส่วนไหนเลย
input/*.glb
input/*.fbx

# ของที่ติดมาตอนทำให้ ComfyUI-UniRig รันได้: ซอร์ส comfy_env ของคนอื่น, .pyc,
# log การติดตั้ง และสคริปต์ที่เขียนทิ้งไว้ไล่ปัญหา ไม่ใช่โค้ดของโปรเจกต์นี้
unirig_ref/

